    "esbuild": "0.28.2",
    "ipfs-unixfs-importer": "17.1.1",
    "multiformats": "14.0.5",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 120,
    "proseWrap": "always"
  }
